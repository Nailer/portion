{
  "name": "portion",
  "private": true,
  "version": "0.1.0",
  "description": "Own a portion of things that earn. Native-composition RWA platform for Portaldot V3.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "contracts:build": "cd contracts && forge build && cd .. && node scripts/export-artifacts.mjs",
    "contracts:test": "cd contracts && forge test",
    "keygen": "node scripts/keygen.mjs",
    "test": "npm run contracts:test && npm run test -w @portion/sdk && npm run test -w @portion/web && npm run test -w @portion/server",
    "deploy": "tsx scripts/deploy.ts",
    "deploy:check": "tsx scripts/deploy.ts --check",
    "server": "npm run start -w @portion/server",
    "teleport:local": "tsx scripts/teleport-local.ts",
    "deploy:bnb": "tsx scripts/deploy-bnb.ts",
    "e2e": "tsx scripts/e2e.ts",
    "typecheck": "tsc -p scripts/tsconfig.json --noEmit && npm run typecheck -w @portion/sdk -w @portion/server -w @portion/web",
    "dev": "node scripts/dev.mjs",
    "deploy:core": "tsx scripts/deploy.ts --core",
    "deploy:check:core": "tsx scripts/deploy.ts --check --core",
    "deploy:check:candidate": "tsx scripts/check-core-candidate.ts",
    "deploy:check:core-v2": "tsx scripts/deploy-core-v2.ts",
    "build": "node scripts/build-api.mjs && npm run build -w @portion/web",
    "budget:status": "tsx scripts/budget-status.ts",
    "backup:documents": "tsx scripts/backup-public-documents.ts",
    "faucet:reconcile": "tsx scripts/reconcile-test-credits.ts"
  },
  "devDependencies": {
    "@polkadot/api": "^16.5.0",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "@portion/sdk": "*",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.0",
    "esbuild": "0.25.12",
    "ethers": "^6.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "npm@11.21.1",
  "overrides": {
    "zod": "4.6.6"
  }
}
