# Copy to .env, or just run `npm run keygen` which creates it for you.
PORTALDOT_WS=wss://test-node-v3.portaldot.dev
PORTALDOT_EVM_RPC=https://test-evm-rpc-v3.portaldot.dev
DEPLOYER_MNEMONIC=            # Deployment only. Never implicitly used by server jobs.
EVM_OPS_KEY=                  # 0x…  deploys on BNB testnet and pays gas for relayed transfers
RELAYER_1_KEY=                # 0x…  signing-only keys of the Teleport committee
RELAYER_2_KEY=
RELAYER_3_KEY=
BNB_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# optional tuning
# HOST=127.0.0.1  PORT=8787
# DRIP_POT=3  DRIP_PUSD=500  DRIP_COOLDOWN=86400  DRIP_PER_IP=5  DRIP_GLOBAL=200
# Spending features are OFF unless explicitly enabled. Existing keys alone do not enable them.
FAUCET=off
FAUCET_MNEMONIC=              # Separately funded test wallet, not the deployment allocation
KEEPERS=off
KEEPER_MNEMONIC=              # Separately funded wallet for automated maintenance
RELAYER=off                  # Enable only after budgeting EVM gas on both networks
